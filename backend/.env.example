# ==============================================================================
# GMS CRM - Environment Variables Configuration
# ==============================================================================
# This is an example configuration file. Copy this file to '.env' in your
# deployment environment and populate the values accordingly.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
BACKEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB & Redis)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/gms_crm
MONGODB_URI=mongodb://127.0.0.1:27017/gms_crm
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional: Use REDIS_URL if using a managed Redis service (overrides host/port)
# REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Replace with a strong random string (e.g., openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Meta / WhatsApp Business API Integration
# ------------------------------------------------------------------------------
# System access token for Meta Graph API
META_ACCESS_TOKEN=your_meta_access_token_here

# WABA (WhatsApp Business Account) ID
META_WABA_ID=your_meta_waba_id_here

# Phone Number ID configured in Meta App
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# App Secret from Meta App Dashboard (used for webhook signature validation)
META_APP_SECRET=your_meta_app_secret_here

# Webhook verify token (you define this, must match the one submitted to Meta)
WEBHOOK_VERIFY_TOKEN=your_custom_verify_token_here

# Meta Graph API Version (defaults to v19.0)
META_API_VERSION=v19.0

# Broadcast Queue Tuning
WHATSAPP_BROADCAST_BATCH_SIZE=500
WHATSAPP_BROADCAST_CONCURRENCY=10
WHATSAPP_BROADCAST_RATE_LIMIT=80

# ------------------------------------------------------------------------------
# 5. Telephony / Calling Integration
# ------------------------------------------------------------------------------
# e.g., 'Mock Provider', 'Exotel', 'Twilio'
TELEPHONY_PROVIDER=Mock Provider

# ------------------------------------------------------------------------------
# 6. File & Media Storage
# ------------------------------------------------------------------------------
# Options: 'LOCAL' or 'S3'
STORAGE_PROVIDER=LOCAL
CLOUD_STORAGE_BUCKET=your_s3_bucket_name_here

# ------------------------------------------------------------------------------
# 7. Queue Configuration (BullMQ)
# ------------------------------------------------------------------------------
QUEUE_PROVIDER=redis
QUEUE_RETRY_LIMIT=3
QUEUE_BACKOFF=5000

# ------------------------------------------------------------------------------
# 8. Application Feature Flags & Defaults
# ------------------------------------------------------------------------------
ENABLE_WHATSAPP_NOTIFICATIONS=true
ENABLE_ECC_PHASE_5A=true
DEFAULT_COUNTRY_CODE=91
